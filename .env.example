# Never put real credentials in this file in a public repository.
# For Cloudflare deployment, use `wrangler secret put` for secrets.
GEMINI_API_KEY=
JALALAI_ACCESS_TOKEN=
# Set this to the exact deployed web origin, e.g. https://your-project.pages.dev
ALLOWED_ORIGINS=https://YOUR-PROJECT.pages.dev
ALLOWED_MODELS=gemini-2.5-flash
RATE_LIMIT=30
RATE_WINDOW_SECONDS=60
